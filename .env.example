# Required for MongoDB database and sessions
MONGO_URL=

# Used to encrypt Express sessions
SESSION_SECRET=

# Cloudinary image storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Google OAuth (optional; local username/password login works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gmail SMTP for signup verification emails
EMAIL_ID=
EMAIL_PASS=
